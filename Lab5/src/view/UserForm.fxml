<?xml version="1.0" encoding="UTF-8"?>

<!--
  VIEW: describes only what the screen looks like.
  Open this file in Scene Builder to edit it visually.
  fx:controller links it to the controller class.
  fx:id values become @FXML fields in the controller.
  onAction="#handleSubmit" calls the controller's handleSubmit method.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" prefWidth="460.0" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/27" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.UserFormController">
   <padding>
      <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
   </padding>
   <children>
      <Label styleClass="title" text="User Registration" />

      <GridPane hgap="12.0" vgap="4.0">
         <columnConstraints>
            <ColumnConstraints minWidth="70.0" />
            <ColumnConstraints hgrow="ALWAYS" />
         </columnConstraints>
         <children>
            <Label text="Name" GridPane.rowIndex="0" />
            <TextField fx:id="nameField" promptText="e.g. Jane Doe" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label fx:id="nameError" styleClass="error-text" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Age" GridPane.rowIndex="2" />
            <TextField fx:id="ageField" promptText="1 to 120" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label fx:id="ageError" styleClass="error-text" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label text="Email" GridPane.rowIndex="4" />
            <TextField fx:id="emailField" promptText="e.g. jane@example.com" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <Label fx:id="emailError" styleClass="error-text" GridPane.columnIndex="1" GridPane.rowIndex="5" />
         </children>
      </GridPane>

      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button onAction="#handleClear" text="Clear" />
            <Button fx:id="submitButton" defaultButton="true" onAction="#handleSubmit" text="Submit" />
         </children>
      </HBox>
   </children>
</VBox>
